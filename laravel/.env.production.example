# ─── Ansar Mahmood — Laravel API (api.ansarmahmood.org) PRODUCTION ───
# Copy to `.env` on the server, fill the blanks, then:
#   php artisan key:generate
#   php artisan config:cache && php artisan route:cache
#   php artisan migrate --force

APP_NAME="Ansar Mahmood"
APP_ENV=production
APP_KEY=
APP_DEBUG=false

# This API's own URL (the subdomain whose web root is laravel/public)
APP_URL=https://api.ansarmahmood.org
# The public website (React SPA) — used for post-verification redirects + CORS
FRONTEND_URL=https://ansarmahmood.org

# ─── Database (create in hPanel → MySQL Databases) ───
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# ─── Mail (Hostinger SMTP — create mailbox no-reply@ansarmahmood.org) ───
MAIL_MAILER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=no-reply@ansarmahmood.org
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="no-reply@ansarmahmood.org"
MAIL_FROM_NAME="Ansar Mahmood"

LOG_CHANNEL=stack
SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
